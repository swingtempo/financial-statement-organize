<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only: the managed PDF backend (PdfiumViewer) renders through
         System.Drawing, which is Windows-only on .NET 9. Use PDF_BACKEND=poppler
         on other platforms. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF rasterization / text extraction: managed wrapper around the
         (open-source, Apache-2.0) Chromium PDFium. The native runtime ships in
         bblanchon.PDFium (pre-compiled Chromium pdfium, Apache-2.0, built
         weekly); PdfTools points the wrapper at it at startup. -->
    <PackageReference Include="PdfiumViewer.Updated" Version="2.14.5" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8138" />
  </ItemGroup>

</Project>
