<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PIAPath>$(MSBuildProgramFiles32)\..\..\Windows\assembly\GAC_MSIL\Microsoft.Office.Interop.OneNote\15.0.0.0__71e9bce111e9429c\Microsoft.Office.Interop.OneNote.dll</PIAPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.8 reference assemblies (no local targeting pack needed) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <!-- JSON (not in the net48 BCL) -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <!-- PDF rasterization (managed PDFium: Apache-2.0 PdfiumViewer wrapper; the
         native win runtime ships in bblanchon.PDFium; has a net48-compatible build) -->
    <PackageReference Include="PdfiumViewer.Updated" Version="2.14.5" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8138" />
    <!-- The genuine OneNote COM interop (PIA). SDK projects don't search the GAC,
         so point it at the GAC DLL where Office installs it. -->
    <Reference Include="Microsoft.Office.Interop.OneNote">
      <HintPath>$(PIAPath)</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms / drawing references (explicit so the build is independent of
         UseWindowsForms behavior across SDK versions). -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>


</Project>

