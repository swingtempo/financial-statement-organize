# LLM configuration (any OpenAI-compatible API works)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

INPUT_DIR=./input
OUTPUT_DIR=./organized

# Vision backend: max pages rasterized per PDF
MAX_PAGES=20

# Vision backend: rasterization DPI
PDF_DPI=150

# PDF engine: managed (default, bundled PDFium — nothing to install)
#            poppler  (use pdftoppm/pdftotext if they are on PATH)
PDF_BACKEND=managed
